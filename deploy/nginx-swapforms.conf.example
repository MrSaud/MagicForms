# Example nginx site for MagicForms on swapforms.com
# Install: sudo cp deploy/nginx-swapforms.conf.example /etc/nginx/conf.d/magicforms.conf
# Edit ssl_certificate paths, then: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name swapforms.com www.swapforms.com *.swapforms.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name swapforms.com www.swapforms.com *.swapforms.com;

    # ssl_certificate     /etc/letsencrypt/live/swapforms.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/swapforms.com/privkey.pem;

    client_max_body_size 50M;

    location /static/ {
        alias /var/www/magicforms/staticfiles/;
    }

    location /media/ {
        alias /var/www/magicforms/media/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_redirect off;
        proxy_buffering off;

        # REQUIRED: pass the browser hostname (fff.swapforms.com, mosa-kuwait.swapforms.com, …)
        proxy_set_header Host $host;
        proxy_set_header X-Portal-Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
